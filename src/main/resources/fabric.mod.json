{
  "schemaVersion": 1,
  "id": "jnlyrics",
  "version": "${version}",
  "name": "JNLyrics",
  "description": "Experience synced 3D floating lyrics and a modern music HUD in Minecraft while listening to music players.",
  "authors": [
    "Zein"
  ],
  "contact": {
    "homepage": "https://github.com/zein/JNLyrics"
  },
  "license": "MIT",
  "icon": "assets/jnlyrics/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.jnlyrics.JNLyricsMod"
    ]
  },
  "mixins": [
    "jnlyrics.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=26.1 <=26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}